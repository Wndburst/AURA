# ☠️ AURA FARM ☠️ — plantilla de configuración
#
# Copia este archivo a `.env` y edítalo. Node lo carga solo al arrancar
# (`npm start` y `npm run dev`), así no hay que exportar nada a mano — y menos
# pelear con la sintaxis de PowerShell.
#
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)
#
# Todo tiene default sensato: puedes desplegar sin definir nada de esto.
# Las variables del entorno real tienen prioridad sobre este archivo.

# --- servidor ---
PORT=8080
NODE_ENV=production

# Orígenes permitidos, separados por coma. En producción el front sale del mismo
# origen que el servidor, así que esto sólo importa si separas los dominios.
# CORS_ORIGIN=https://aurafarm.cl,https://www.aurafarm.cl

# --- ritmo del juego ---
# Preparación antes de que empiece la batalla (ms).
PREP_MS=60000
# Duración de la batalla (ms).
BATTLE_MS=120000
# Cuánto queda el resultado en pantalla antes de pasar al historial (ms).
RESULT_MS=20000

# --- reglas de juicio ---
# Juicios que puede emitir cada juez por batalla. 0 = ilimitado.
MAX_JUDGMENTS_PER_BATTLE=10
# Cooldown entre juicios de un mismo juez (ms).
JUDGMENT_COOLDOWN_MS=700

# --- persistencia ---
# "off" desactiva el snapshot en disco (el aura se pierde al reiniciar).
PERSISTENCE=on
DATA_DIR=./data

# --- afinado (rara vez hace falta tocarlo) ---
# Lobby sin actividad se elimina después de esto (ms). Default: 6 horas.
# LOBBY_TTL_MS=21600000
# Cada cuánto se difunde el estado y la lista de jugadores (ms).
# STATE_BROADCAST_MS=250
# ROSTER_BROADCAST_MS=1500
