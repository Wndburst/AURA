# Preset para la prueba de carga (`npm run start:load`).
# La batalla dura lo suficiente para que la prueba entera ocurra dentro de ella:
# con el preset de tests (2,5 s) la batalla termina a media prueba y los juicios
# se rechazan con BATTLE_NOT_ACTIVE — parece un bug del servidor y no lo es.
PORT=8099
PREP_MS=2000
BATTLE_MS=60000
RESULT_MS=2000
PERSISTENCE=off
